{
  "name": "vitezola",
  "version": "1.0.0",
  "description": "VitePress default theme ported to Zola (Tailwind CSS)",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i css/main.css -o static/main.css --minify",
    "watch:css": "tailwindcss -i css/main.css -o static/main.css --watch",
    "build": "npm run build:css && zola build",
    "dev": "tailwindcss -i css/main.css -o static/main.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newlix/vitezola.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  },
  "private": true
}
