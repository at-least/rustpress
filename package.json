{
  "name": "vitezola",
  "version": "1.0.0",
  "description": "VitePress default theme ported to Zola (Tailwind CSS)",
  "scripts": {
    "test": "npm run build && npm run check",
    "check": "python3 scripts/check_vpdoc_classes.py",
    "build:css": "tailwindcss -i css/main.css -o static/main.css --minify",
    "watch:css": "tailwindcss -i css/main.css -o static/main.css --watch",
    "build:js": "esbuild js/main.js --bundle --format=iife --target=es2017 --banner:js='\"use strict\";' --outfile=static/js/app.js",
    "watch:js": "esbuild js/main.js --bundle --format=iife --target=es2017 --banner:js='\"use strict\";' --outfile=static/js/app.js --watch",
    "build": "npm run build:js && npm run build:css && zola build",
    "dev": "npm run watch:css & npm run watch:js & zola serve & wait"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newlix/vitezola.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2"
  },
  "private": true
}
