{
  "name": "gen-docs",
  "version": "1.0.0",
  "description": "VitePress default theme ported to Zola (Tailwind CSS)",
  "scripts": {
    "test": "cargo test --quiet && npm run build:js && npm run build:css && npm run check:demo",
    "check:demo": "cargo run --quiet -- build demo",
    "build:css": "tailwindcss -i styles/main.css -o static/main.css --minify",
    "watch:css": "tailwindcss -i styles/main.css -o static/main.css --watch",
    "build:js": "esbuild js/alpine-entry.js --bundle --format=iife --target=es2018 --minify --outfile=static/js/app.js",
    "watch:js": "esbuild js/alpine-entry.js --bundle --format=iife --target=es2018 --outfile=static/js/app.js --watch",
    "build": "npm run build:js && npm run build:css && cargo run --quiet -- build demo",
    "dev": "npm run watch:css & npm run watch:js & cargo run -- serve demo & wait"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newlix/gen-docs.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@alpinejs/collapse": "^3.17.2",
    "@alpinejs/intersect": "^3.17.2",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.2",
    "esbuild": "^0.28.2"
  },
  "private": true
}
